--// CURSOR REAL
local cursor = Instance.new("ImageLabel")
cursor.Name = "CustomMouseCursor"
cursor.Size = UDim2.fromOffset(32,32)
cursor.AnchorPoint = Vector2.new(0.5,0.5)
cursor.BackgroundTransparency = 1
cursor.Visible = false
cursor.Active = false
cursor.ZIndex = 999999
cursor.Parent = gui

local enabled = true

local function SetCursor(id)
	cursor.Image = id

	if enabled then
		cursor.Visible = true
		UserInputService.MouseIconEnabled = false
	end
end

--// POSICIÓN CORREGIDA
RunService.RenderStepped:Connect(function()
	if cursor.Visible then
		local mousePos = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()

		cursor.Position = UDim2.fromOffset(
			mousePos.X - inset.X,
			mousePos.Y - inset.Y
		)
	end
end)

--// ABRIR/CERRAR
openButton.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

closeButton.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

--// CURSORES
for _,data in ipairs(cursors) do
	local name = data[1]
	local id = data[2]

	local button = Instance.new("ImageButton")
	button.Name = name
	button.BackgroundColor3 = Color3.fromRGB(90,40,110)
	button.Image = id
	button.ScaleType = Enum.ScaleType.Fit
	button.Parent = scroll

	Instance.new("UICorner",button).CornerRadius = UDim.new(0,10)

	local buttonStroke = Instance.new("UIStroke")
	buttonStroke.Color = Color3.fromRGB(180,50,120)
	buttonStroke.Thickness = 1
	buttonStroke.Parent = button

	button.MouseButton1Click:Connect(function()
		SetCursor(id)
	end)
end

--// CURSOR INICIAL
SetCursor(cursors[1][2])
